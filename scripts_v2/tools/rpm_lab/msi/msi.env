# MSI (Agate) settings for the RPM Lab world-model jobs. Plain KEY=VALUE lines: sourced by the shell scripts and
# parsed by msi_submit.py. No secrets here (export WANDB_API_KEY in the submitting shell if you ever log online).

# ssh alias of the login host, with a ControlMaster connection (see README: open it once by hand)
MSI_HOST=msi
MSI_USER=cui00191
# Slurm account = the PI's group (`sacctmgr -nP show assoc user=$USER format=account` on MSI)
MSI_ACCOUNT=kdesingh
# Everything lives here on MSI project storage (NFS, a work area, not a backup):
#   UWLab/ (main checkout), UWLab-run-<run>/ (one worktree per run), iws_sandbox/ (Apptainer), venv-iws/,
#   data/iws/<dataset>/, runs/<run>/, logs/<run>_<jobid>.{out,err}
MSI_PROJECT_DIR=/projects/standard/kdesingh/shared/cui00191/WM-cotrain
REPO_URL=https://github.com/morning-star-7/UWLab.git
# Local (workstation) side: the job ledger msi_submit.py appends to, and where msi_sync.sh pulls runs to
LEDGER=/data/cui00191/WM-cotrain/msi_jobs.jsonl
LOCAL_WM_DIR=/data/cui00191/WM-cotrain
# Online wandb: offline runs on MSI are pulled and uploaded from the workstation (its own `wandb login`), msi_sync.sh wandb
WANDB_ENTITY=research-group
WANDB_PROJECT=WM-cotrain
WANDB_PYTHON=/data/cui00191/rpm_lab_envs/wandb_sync/bin/python
